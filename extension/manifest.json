{
  "manifest_version": 3,
  "name": "قفل يوتيوب",
  "version": "1.0.0",
  "description": "يوتيوب بمواعيد ثابتة لطفل صغير، مع صفحة انتظار مبهجة وساعة رملية.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.youtubekids.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "youtube_lock", "enabled": true, "path": "rules.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["lock.html"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtubekids.com/*"],
      "js": ["draw.js", "overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "قفل يوتيوب",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
